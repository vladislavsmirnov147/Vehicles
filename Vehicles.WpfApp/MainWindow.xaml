<Window x:Class="Vehicles.WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vehicles"
        Height="500"
        Width="700">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Vehicle name:"/>
            <TextBox x:Name="NameTextBox"
                     Height="30"
                     Margin="0,5,0,10"/>
        </StackPanel>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Vehicle type:"/>

            <ComboBox x:Name="TypeComboBox"
                      Height="30"
                      Margin="0,5,0,10"
                      SelectedIndex="0">

                <ComboBoxItem Content="Car"/>
                <ComboBoxItem Content="Boat"/>
                <ComboBoxItem Content="AmphibiousCar"/>

            </ComboBox>
        </StackPanel>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Margin="0,0,0,10">

            <Button Content="Add Vehicle"
                    Width="120"
                    Height="35"
                    Margin="0,0,10,0"
                    Click="AddVehicle_Click"/>

            <Button Content="Move (10 km)"
                    Width="120"
                    Height="35"
                    Click="MoveVehicle_Click"/>

        </StackPanel>

        <GroupBox Grid.Row="3"
                  Header="Vehicles"
                  Margin="0,0,0,10">

            <ListBox x:Name="VehiclesListBox"/>

        </GroupBox>

        <GroupBox Grid.Row="4"
                  Header="Log">

            <ListBox x:Name="LogListBox"/>

        </GroupBox>
    </Grid>
</Window>